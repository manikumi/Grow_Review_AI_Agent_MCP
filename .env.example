# ── LLM (Groq) ───────────────────────────────────────────────────────────────
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here

# ── Review Ingestion ──────────────────────────────────────────────────────────
GROWW_APP_ID=com.nextbillion.groww
REVIEW_LOOKBACK_WEEKS=10
REVIEW_MAX_COUNT=500

# ── Output ───────────────────────────────────────────────────────────────────
PULSE_RECIPIENT_EMAIL=you@yourteam.com

# ── MCP Servers ───────────────────────────────────────────────────────────────
GOOGLE_DOCS_MCP_URL=https://gmailgoogledocmcpserver-production.up.railway.app/sse
GMAIL_MCP_URL=https://gmailgoogledocmcpserver-production.up.railway.app/sse
GOOGLE_DOC_URL=https://docs.google.com/document/d/your_doc_id/edit
GOOGLE_DOC_ID=your_doc_id
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

